{"id":2,"name":"オーブ「契約」の台座","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":111,"indent":0,"parameters":[0,103,1]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["台座の上に、赤い光の脈打つ珠が載っている。"]},{"code":250,"indent":1,"parameters":[{"name":"Item3","volume":90,"pitch":100,"pan":0}]},{"code":121,"indent":1,"parameters":[103,103,0]},{"code":122,"indent":1,"parameters":[101,101,1,0,1]},{"code":223,"indent":1,"parameters":[[-68,-68,-68,170],60,true]},{"code":101,"indent":1,"parameters":["",0,1,1,""]},{"code":401,"indent":1,"parameters":["……燃える王都。玉座の間の窓が赤い。"]},{"code":401,"indent":1,"parameters":["王が玉座から降りて、自分の肩をつかむ。「何を払ってもよい。国を守れ」"]},{"code":401,"indent":1,"parameters":["自分は床に陣を描く。古い写本の作法どおりに。手は震えていない。"]},{"code":401,"indent":1,"parameters":["陣の中に、女が立っている。赤い目。黒い髪。"]},{"code":101,"indent":1,"parameters":["",0,1,1,""]},{"code":401,"indent":1,"parameters":["「呼んだのはあなた？　若いのね」女は笑う。「望みは」"]},{"code":401,"indent":1,"parameters":["「死者を兵に。帝国を押し返す力を」"]},{"code":401,"indent":1,"parameters":["「いいわ。代価は、この国の民の魂の灰。少しずつ、全部」"]},{"code":401,"indent":1,"parameters":["王が頷く。自分も、頷く。"]},{"code":101,"indent":1,"parameters":["",0,1,1,""]},{"code":401,"indent":1,"parameters":["女は自分の耳元でささやく。「契約は、あなたが完全な魂でここに立つとき、果たされる」"]},{"code":401,"indent":1,"parameters":["……その女の名を、自分は知っている。セレス。"]},{"code":121,"indent":1,"parameters":[107,107,0]},{"code":223,"indent":1,"parameters":[[0,0,0,0],60,true]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["……セレス。お前だったのか"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["オーブ「契約」を取り戻した。転送陣が光りはじめた。"]},{"code":111,"indent":1,"parameters":[1,101,0,4,1]},{"code":121,"indent":2,"parameters":[105,106,0]},{"code":101,"indent":2,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":2,"parameters":["……全部、思い出した。セレスが門で待っている"]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["台座は空だ。"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":8},
