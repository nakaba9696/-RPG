{"id":2,"name":"オーブ「封印」の台座","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":111,"indent":0,"parameters":[0,104,1]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["台座の上に、白く光る珠が載っている。"]},{"code":250,"indent":1,"parameters":[{"name":"Item3","volume":90,"pitch":100,"pan":0}]},{"code":121,"indent":1,"parameters":[104,104,0]},{"code":122,"indent":1,"parameters":[101,101,1,0,1]},{"code":223,"indent":1,"parameters":[[-68,-68,-68,170],60,true]},{"code":101,"indent":1,"parameters":["",0,1,1,""]},{"code":401,"indent":1,"parameters":["……白い線が、門の内側から空へ伸びていく。自分が描いた陣だ。"]},{"code":401,"indent":1,"parameters":["「外へ。早く」逃げ遅れた女を、下水の口へ押しやる。"]},{"code":401,"indent":1,"parameters":["門が閉じる。王都の民は、皆、家の中で眠りについた。取り立ては、ここで止まる。"]},{"code":401,"indent":1,"parameters":["自分も下水へ降りる。暗い方へ。結界の真下へ。"]},{"code":101,"indent":1,"parameters":["",0,1,1,""]},{"code":401,"indent":1,"parameters":["胸に刃を当てる。錠の印を刻む。痛みは思ったより少ない。"]},{"code":401,"indent":1,"parameters":["足音。振り向くと、赤い目がこちらを見ている。"]},{"code":401,"indent":1,"parameters":["「何をしたの」声がかすれている。"]},{"code":401,"indent":1,"parameters":["「すまない。契約は果たさせない」"]},{"code":101,"indent":1,"parameters":["",0,1,1,""]},{"code":401,"indent":1,"parameters":["「……あなたが死んだら、魂はばらばらになるわよ。誰があなたを拾うの」"]},{"code":401,"indent":1,"parameters":["「次に目を覚ましたら、俺はたぶん何も覚えていない。それでいい」"]},{"code":401,"indent":1,"parameters":["白い光が下りてくる。自分の名前が、もう思い出せない。"]},{"code":223,"indent":1,"parameters":[[0,0,0,0],60,true]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["……門を、開けてはいけない。そう決めたはずだった"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["オーブ「封印」を取り戻した。転送陣が光りはじめた。"]},{"code":111,"indent":1,"parameters":[1,101,0,4,1]},{"code":121,"indent":2,"parameters":[105,106,0]},{"code":101,"indent":2,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":2,"parameters":["……全部、思い出した。セレスが門で待っている"]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["台座は空だ。"]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":8,"y":8},
